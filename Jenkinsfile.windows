pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven-3.9.11'
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        skipStagesAfterUnstable()
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_LOCAL',
            defaultValue: false,
            description: 'If true, Jenkins will run docker compose locally after build.'
        )
        booleanParam(
            name: 'BUILD_DOCKER',
            defaultValue: false,
            description: 'If true, Jenkins will build Docker images. Docker is also required when DEPLOY_LOCAL is true.'
        )
        booleanParam(
            name: 'PUSH_IMAGES',
            defaultValue: false,
            description: 'For non-multibranch jobs, push Docker images to Docker Hub after building.'
        )
        booleanParam(
            name: 'RUN_SECURITY_SCAN',
            defaultValue: false,
            description: 'Run npm audit, Maven dependency-check, and Docker image scan if tools are available.'
        )
        booleanParam(
            name: 'DEPLOY_STAGING',
            defaultValue: false,
            description: 'For non-multibranch jobs, deploy to staging over SSH after pushing images.'
        )
        booleanParam(
            name: 'DEPLOY_PRODUCTION',
            defaultValue: false,
            description: 'If true on main, require manual approval before production deploy.'
        )
        booleanParam(
            name: 'DISCORD_NOTIFY',
            defaultValue: false,
            description: 'Send build notifications to Discord using Jenkins credential discord-webhook-url.'
        )
        string(
            name: 'DOCKER_NAMESPACE',
            defaultValue: 'phuongdaithang',
            description: 'Docker Hub namespace or organization, for example phuongdaithang.'
        )
        string(
            name: 'STAGING_HOST',
            defaultValue: '',
            description: 'Staging server hostname or IP. Required for staging deploy.'
        )
        string(
            name: 'STAGING_USER',
            defaultValue: 'deploy',
            description: 'SSH user for staging deploy.'
        )
        string(
            name: 'STAGING_DEPLOY_DIR',
            defaultValue: '/opt/jenkins-demo',
            description: 'Directory on staging server containing docker-compose.yml.'
        )
        string(
            name: 'STAGING_SMOKE_URL',
            defaultValue: '',
            description: 'Staging smoke test URL, for example https://staging.example.com/api/hello.'
        )
        string(
            name: 'PRODUCTION_HOST',
            defaultValue: '',
            description: 'Production server hostname or IP. Required only when DEPLOY_PRODUCTION is true.'
        )
        string(
            name: 'PRODUCTION_USER',
            defaultValue: 'deploy',
            description: 'SSH user for production deploy.'
        )
        string(
            name: 'PRODUCTION_DEPLOY_DIR',
            defaultValue: '/opt/jenkins-demo',
            description: 'Directory on production server containing docker-compose.yml.'
        )
        string(
            name: 'PRODUCTION_SMOKE_URL',
            defaultValue: '',
            description: 'Production smoke test URL.'
        )
    }

    environment {
        BACKEND_IMAGE_NAME = 'jenkins-demo-backend'
        FRONTEND_IMAGE_NAME = 'jenkins-demo-frontend'
        BACKEND_IMAGE = ''
        FRONTEND_IMAGE = ''
        GIT_SHA = ''
        COMPOSE_PROJECT_NAME = 'jenkins_demo'
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials'
        STAGING_SSH_CREDENTIALS_ID = 'staging-ssh-key'
        PRODUCTION_SSH_CREDENTIALS_ID = 'production-ssh-key'
        DISCORD_WEBHOOK_CREDENTIALS_ID = 'discord-webhook-url'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA = bat(returnStdout: true, script: '@git rev-parse --short HEAD').trim()
                    env.BACKEND_IMAGE = "${params.DOCKER_NAMESPACE}/${env.BACKEND_IMAGE_NAME}:${env.GIT_SHA}"
                    env.FRONTEND_IMAGE = "${params.DOCKER_NAMESPACE}/${env.FRONTEND_IMAGE_NAME}:${env.GIT_SHA}"
                }
                echo "Branch: ${env.BRANCH_NAME ?: 'single-branch-job'}"
                echo "Commit SHA: ${env.GIT_SHA}"
                echo "Backend image: ${env.BACKEND_IMAGE}"
                echo "Frontend image: ${env.FRONTEND_IMAGE}"
            }
        }

        stage('Verify Tools') {
            steps {
                bat '''
                    java -version
                    mvn -version
                    node --version
                    npm --version
                '''
            }
        }

        stage('Docker: Verify') {
            when {
                expression {
                    if (env.BRANCH_NAME) {
                        return env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop'
                    }
                    return params.BUILD_DOCKER || params.PUSH_IMAGES || params.DEPLOY_LOCAL || params.DEPLOY_STAGING || params.DEPLOY_PRODUCTION
                }
            }
            steps {
                bat '''
                    docker --version
                    docker info >nul 2>&1 || (
                        echo Docker daemon is not running. Start Docker Desktop or the Docker service before running Docker stages.
                        exit /b 1
                    )
                '''
            }
        }

        stage('Backend: Checkstyle') {
            steps {
                dir('backend') {
                    bat 'mvn -B checkstyle:check'
                }
            }
        }

        stage('Backend: Test') {
            steps {
                dir('backend') {
                    bat 'mvn -B test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/target/site/jacoco/**', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        stage('Backend: Package') {
            steps {
                dir('backend') {
                    bat 'mvn -B -DskipTests package'
                }
            }
            post {
                success {
                    echo 'Archiving backend jar artifacts from backend/target/*.jar'
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true, onlyIfSuccessful: true
                }
            }
        }

        stage('Frontend: Install Dependencies') {
            steps {
                dir('frontend') {
                    bat 'npm install'
                }
            }
        }

        stage('Frontend: Lint') {
            steps {
                dir('frontend') {
                    bat 'npm run lint'
                }
            }
        }

        stage('Frontend: Test') {
            steps {
                dir('frontend') {
                    bat 'npm test -- --run'
                }
            }
        }

        stage('Security: Dependency Scan') {
            when {
                expression { return params.RUN_SECURITY_SCAN }
            }
            steps {
                dir('frontend') {
                    bat 'npm audit --audit-level=high'
                }
                dir('backend') {
                    bat 'mvn -B org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=7'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'backend/target/dependency-check-report.*', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        stage('Frontend: Build') {
            steps {
                dir('frontend') {
                    bat 'npm run build'
                }
                bat '''
                    if exist dist rmdir /s /q dist
                    xcopy frontend\\dist dist\\ /E /I /Y
                '''
            }
            post {
                success {
                    echo 'Archiving frontend static build artifacts from dist/**'
                    archiveArtifacts artifacts: 'dist/**', fingerprint: true, onlyIfSuccessful: true
                }
            }
        }

        stage('Say Hello From Pipeline') {
            steps {
                echo 'This stage was added by editing Jenkinsfile.'
            }
        }

        stage('Docker: Build Images') {
            when {
                expression {
                    if (env.BRANCH_NAME) {
                        return env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop'
                    }
                    return params.BUILD_DOCKER || params.PUSH_IMAGES || params.DEPLOY_LOCAL || params.DEPLOY_STAGING || params.DEPLOY_PRODUCTION
                }
            }
            steps {
                retry(2) {
                    bat '''
                        docker build --pull -t %BACKEND_IMAGE% backend
                        docker build --pull -t %FRONTEND_IMAGE% frontend
                        echo Built Docker images:
                        echo   %BACKEND_IMAGE%
                        echo   %FRONTEND_IMAGE%
                    '''
                }
            }
        }

        stage('Docker: Push Images') {
            when {
                expression {
                    if (env.BRANCH_NAME) {
                        return env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop'
                    }
                    return params.PUSH_IMAGES || params.DEPLOY_STAGING || params.DEPLOY_PRODUCTION
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    retry(2) {
                        bat '''
                            echo %DOCKERHUB_TOKEN% | docker login -u %DOCKERHUB_USER% --password-stdin
                            docker push %BACKEND_IMAGE%
                            docker push %FRONTEND_IMAGE%
                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Security: Image Scan') {
            when {
                expression { return params.RUN_SECURITY_SCAN && (env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop' || params.BUILD_DOCKER || params.PUSH_IMAGES) }
            }
            steps {
                bat '''
                    trivy image --exit-code 1 --severity HIGH,CRITICAL %BACKEND_IMAGE%
                    trivy image --exit-code 1 --severity HIGH,CRITICAL %FRONTEND_IMAGE%
                '''
            }
        }

        stage('Deploy Local Demo') {
            when {
                expression {
                    if (env.BRANCH_NAME) {
                        return false
                    }
                    return params.DEPLOY_LOCAL
                }
            }
            steps {
                retry(2) {
                    bat '''
                        set BACKEND_IMAGE=%BACKEND_IMAGE%
                        set FRONTEND_IMAGE=%FRONTEND_IMAGE%
                        docker compose -f docker-compose.jenkins.yml up -d --remove-orphans
                    '''
                }
            }
        }

        stage('Deploy Staging') {
            when {
                expression {
                    def shouldDeploy = env.BRANCH_NAME == 'main' || (!env.BRANCH_NAME && params.DEPLOY_STAGING)
                    return shouldDeploy && params.STAGING_HOST?.trim()
                }
            }
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: env.STAGING_SSH_CREDENTIALS_ID,
                    keyFileVariable: 'SSH_KEY_FILE'
                )]) {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $remote = "$env:STAGING_USER@$env:STAGING_HOST"
                        $imageEnv = "BACKEND_IMAGE='$env:BACKEND_IMAGE' FRONTEND_IMAGE='$env:FRONTEND_IMAGE'"
                        $command = "cd '$env:STAGING_DEPLOY_DIR' && $imageEnv docker compose pull && $imageEnv docker compose up -d"

                        Write-Host "Deploying staging to $remote"
                        ssh -i "$env:SSH_KEY_FILE" -o StrictHostKeyChecking=no $remote $command
                    '''
                }
            }
        }

        stage('Smoke Test Staging') {
            when {
                expression {
                    def shouldDeploy = env.BRANCH_NAME == 'main' || (!env.BRANCH_NAME && params.DEPLOY_STAGING)
                    return shouldDeploy && params.STAGING_SMOKE_URL?.trim()
                }
            }
            steps {
                powershell '''
                    $ErrorActionPreference = 'Stop'
                    Write-Host "Smoke testing staging endpoint: $env:STAGING_SMOKE_URL"
                    Invoke-WebRequest -Uri "$env:STAGING_SMOKE_URL" -UseBasicParsing -TimeoutSec 15 | Out-Null
                    Write-Host "Staging smoke test passed."
                '''
            }
        }

        stage('Approve Production Deploy') {
            when {
                expression { return env.BRANCH_NAME == 'main' && params.DEPLOY_PRODUCTION }
            }
            steps {
                input message: 'Deploy to production?', ok: 'Deploy', submitter: 'release-manager,admin'
            }
        }

        stage('Deploy Production') {
            when {
                expression { return env.BRANCH_NAME == 'main' && params.DEPLOY_PRODUCTION && params.PRODUCTION_HOST?.trim() }
            }
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: env.PRODUCTION_SSH_CREDENTIALS_ID,
                    keyFileVariable: 'SSH_KEY_FILE'
                )]) {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $remote = "$env:PRODUCTION_USER@$env:PRODUCTION_HOST"
                        $imageEnv = "BACKEND_IMAGE='$env:BACKEND_IMAGE' FRONTEND_IMAGE='$env:FRONTEND_IMAGE'"
                        $command = "cd '$env:PRODUCTION_DEPLOY_DIR' && $imageEnv docker compose pull && $imageEnv docker compose up -d"

                        Write-Host "Deploying production to $remote"
                        ssh -i "$env:SSH_KEY_FILE" -o StrictHostKeyChecking=no $remote $command
                    '''
                }
            }
        }

        stage('Smoke Test Production') {
            when {
                expression { return env.BRANCH_NAME == 'main' && params.DEPLOY_PRODUCTION && params.PRODUCTION_SMOKE_URL?.trim() }
            }
            steps {
                powershell '''
                    $ErrorActionPreference = 'Stop'
                    Write-Host "Smoke testing production endpoint: $env:PRODUCTION_SMOKE_URL"
                    Invoke-WebRequest -Uri "$env:PRODUCTION_SMOKE_URL" -UseBasicParsing -TimeoutSec 15 | Out-Null
                    Write-Host "Production smoke test passed."
                '''
            }
        }

        stage('Smoke Test') {
            when {
                expression {
                    if (env.BRANCH_NAME) {
                        return env.BRANCH_NAME == 'main'
                    }
                    return params.DEPLOY_LOCAL
                }
            }
            steps {
                powershell '''
                    $ErrorActionPreference = 'Stop'

                    function Wait-Url {
                        param(
                            [string]$Url,
                            [string]$Name
                        )

                        Write-Host "Waiting for $Name at $Url"
                        for ($i = 1; $i -le 30; $i++) {
                            try {
                                Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 5 | Out-Null
                                Write-Host "$Name is ready."
                                return
                            }
                            catch {
                                Write-Host "$Name is not ready yet. Retry $i/30..."
                                Start-Sleep -Seconds 2
                            }
                        }

                        throw "$Name did not become ready at $Url."
                    }

                    Wait-Url "http://localhost:8080/api/hello" "Backend"
                    Wait-Url "http://localhost:5174" "Frontend"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully.'
        }
        failure {
            echo 'Pipeline failed. Open the failed stage log to see the exact command/error.'
        }
        always {
            echo "Build result: ${currentBuild.currentResult}"
            echo "Docker image tag: ${env.GIT_SHA}"
            echo "Backend image: ${env.BACKEND_IMAGE}"
            echo "Frontend image: ${env.FRONTEND_IMAGE}"
            script {
                env.BUILD_RESULT = currentBuild.currentResult
                if (params.DISCORD_NOTIFY) {
                    withCredentials([string(credentialsId: env.DISCORD_WEBHOOK_CREDENTIALS_ID, variable: 'DISCORD_WEBHOOK_URL')]) {
                        powershell '''
                            $ErrorActionPreference = 'Stop'
                            $payload = @{
                                content = "Jenkins: $env:JOB_NAME #$env:BUILD_NUMBER [$env:BRANCH_NAME] $env:BUILD_RESULT commit $env:GIT_SHA $env:BUILD_URL"
                            } | ConvertTo-Json
                            Invoke-RestMethod -Uri "$env:DISCORD_WEBHOOK_URL" -Method Post -ContentType 'application/json' -Body $payload | Out-Null
                        '''
                    }
                }
            }
            echo 'Cleaning Jenkins workspace.'
            deleteDir()
        }
    }
}
